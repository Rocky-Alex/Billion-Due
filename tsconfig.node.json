{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strict": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "website/server/**/*.ts",
    "tests/**/*.ts",
    "shared/src/**/*"
  ]
}

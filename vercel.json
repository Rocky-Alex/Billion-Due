{
  "buildCommand": "npm run build:website",
  "outputDirectory": "website/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

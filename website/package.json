{
  "name": "@billiondue/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BillionDue Owner and Client Web Portals + Neon PostgreSQL API",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host localhost --port 3001",
    "dev:api": "node --watch-path=server --env-file=../.env.local server/api.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/api.mjs"
  },
  "dependencies": {
    "@billiondue/shared": "*",
    "lucide-react": "latest",
    "nodemailer": "^10.1.7",
    "pg": "^8.16.3",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}


{
  "name": "@billiondue/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BillionDue Windows Invoice Desktop Application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host localhost --port 3002",
    "build": "tsc -b && vite build",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:3002 && electron .\"",
    "build:desktop": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "author": "Team BC Dev",
  "dependencies": {},
  "devDependencies": {
    "@billiondue/shared": "*",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
